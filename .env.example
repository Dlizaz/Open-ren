# Runway API key (tạo tại dev.runwayml.com, KHÔNG phải tài khoản web thường)
# Chỉ bắt buộc nếu bạn dùng nguồn "Runway".
RUNWAYML_API_SECRET=

# Pixazo API key (lấy free tại pixazo.ai). Chỉ bắt buộc nếu bạn dùng nguồn
# "Pixazo (LTX)".
PIXAZO_KEY=

# URL công khai của chính web này (vd: https://open-ren.up.railway.app),
# KHÔNG có dấu / ở cuối. Dùng để tạo link ảnh public gửi cho Pixazo (Pixazo
# bắt buộc image_url phải là link internet thật, không nhận base64).
# Để trống nếu deploy trên host tự có domain public (Railway...) - server sẽ
# tự suy ra từ chính request. Bắt buộc phải điền nếu domain thật khác với
# domain request nhận được (vd chạy sau CDN/proxy riêng).
PUBLIC_BASE_URL=

# Connection string MongoDB Atlas (Database > Connect > Drivers), dạng:
# mongodb+srv://user:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Tên database dùng để lưu trạng thái + video + ảnh (không bắt buộc, mặc định open_ren_queue)
MONGODB_DB_NAME=open_ren_queue

# Nội dung file JSON của Google Service Account, dán nguyên 1 dòng (xem README)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID của folder Google Drive muốn lưu video vào (lấy từ URL folder)
GOOGLE_DRIVE_FOLDER_ID=

# Số video render song song cùng lúc
QUEUE_CONCURRENCY=2

# Railway sẽ tự set PORT, để trống khi deploy
PORT=3000
